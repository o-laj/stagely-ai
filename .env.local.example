# Copy this file to .env.local (which is gitignored) and fill in your real key.

# Your free Gemini API key from https://aistudio.google.com/apikey
# NOTE: because extraction runs client-side (Option A), this key ends up
# visible in your app's JS bundle. Fine for personal use — if this app ever
# gets real outside users, move the Gemini call behind a small server first.
VITE_GEMINI_API_KEY= api-key
